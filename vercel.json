{
  "functions": {
    "api/page.js": { "includeFiles": "templates/**" }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/page?page=index" },
    { "source": "/index.html", "destination": "/api/page?page=index" },
    { "source": "/collections.html", "destination": "/api/page?page=collections" },
    { "source": "/collection.html", "destination": "/api/page?page=collection" },
    { "source": "/product.html", "destination": "/api/page?page=product" },
    { "source": "/sitemap.xml", "destination": "/api/seo?file=sitemap" },
    { "source": "/robots.txt", "destination": "/api/seo?file=robots" },
    { "source": "/feed.xml", "destination": "/api/seo?file=feed" },
    { "source": "/images/products/:id", "destination": "/api/seo?file=image&id=:id" }
  ]
}
