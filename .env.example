# Admin portal login. Required to save products or homepage content.
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=use_a_long_unique_password
# Optional: Stripe promotion code shown to new VIP subscribers (create it in Stripe first).
WELCOME_PROMO_CODE=
WELCOME_OFFER_TEXT=Use this code at checkout for 10% off your first order.
# Optional: email buyers a review link N days after they order (needs RESEND_API_KEY
# and a sender on a domain verified in Resend, e.g. Aura Society Co <orders@aurasociety.co>).
REVIEW_REQUEST_EMAILS=off
REVIEW_REQUEST_DELAY_DAYS=7
REVIEW_EMAIL_FROM=
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Optional: use if Stripe gives you a custom payment method configuration ID.
STRIPE_PAYMENT_METHOD_CONFIGURATION=
RESEND_API_KEY=re_your_resend_api_key_here
ORDER_NOTIFICATION_EMAIL=xswann07@gmail.com
ORDER_NOTIFICATION_FROM=Aura Society Co <onboarding@resend.dev>
SITE_URL=http://localhost:4173
PORT=4173
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_PRODUCTS_TABLE=site_settings
KV_REST_API_URL=https://your-upstash-database.upstash.io
KV_REST_API_TOKEN=your_kv_rest_api_token
